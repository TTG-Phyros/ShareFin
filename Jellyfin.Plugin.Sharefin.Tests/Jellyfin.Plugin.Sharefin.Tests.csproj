<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <!-- The plugin excludes Jellyfin's runtime assemblies (the server provides them); tests need them. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Plugin.Sharefin\Jellyfin.Plugin.Sharefin.csproj" />
  </ItemGroup>

</Project>
